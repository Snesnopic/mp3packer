(executable
 (name mp3packer)
 (modules
  types
  p
  pack
  crc
  list2
  expandarray
  unicode
  ptr
  threadpool
  mp3framehuffman
  mp3frameutils
  mp3read
  mp3write
  mp3info
  mp3queue
  mp3packer)
 (libraries unix threads str)
 (foreign_stubs
  (language c)
  (names
   c_part
   ptr-c
   unicode-c
   mp3framehuffman-c
   mp3frameutils-c)
  
  ; --- alternative (enabled_if) solution ---
  
  ; rule 1: for intel architectures
  (rule
   (target flags.sexp)
   ; this rule is enabled only if the boolean condition is true
   (enabled_if (or (= %{ocaml_config:architecture} "x86_64")
                   (= %{ocaml_config:architecture} "amd64")
                   (= %{ocaml_config:architecture} "i686")))
   ; action: print the desired flags s-expression
   (action (with-stdout-to %{target} (echo "(-mssse3 -msse4.1)"))))

  ; rule 2: fallback for all other architectures
  (rule
   (target flags.sexp)
   ; this rule enables if rule 1's condition is false
   (enabled_if (not (or (= %{ocaml_config:architecture} "x86_64")
                        (= %{ocaml_config:architecture} "amd64")
                        (= %{ocaml_config:architecture} "i686"))))
   ; action: print an empty list s-expression
   (action (with-stdout-to %{target} (echo "()"))))
  
  ; --- end alternative solution ---

  ; as before, we include the generated file
  (flags :standard (:include flags.sexp))
 )
